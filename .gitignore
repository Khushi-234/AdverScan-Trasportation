# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/
.env

# Testing & Quality Assurance
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Logs and databases
*.log
logs/
mlruns/
*.db
*.db-wal
*.db-shm

# Persistent SQLite Storage, Backups and Evaluation Artifacts
storage_data/*
!storage_data/.gitkeep
storage_data/artifacts/*
!storage_data/artifacts/.gitkeep
storage_data/backups/*
!storage_data/backups/.gitkeep

# Datasets, model weights, and scan outputs (large files & caches)
data/*
!data/.gitkeep
models/*
!models/.gitkeep
results/*
!results/.gitkeep
reports/*
!reports/.gitkeep
*.pt
*.pth
*.bin
*.onnx
*.safetensors

# Streamlit secrets and caches
.streamlit/secrets.toml

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# OS generated
.DS_Store
Thumbs.db
